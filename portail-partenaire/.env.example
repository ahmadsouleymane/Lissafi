# ============================================================
# LISSAFI — PORTAIL PARTENAIRE (projet séparé du back-office admin)
# ============================================================
# Ces variables sont utilisées côté serveur (server components + server
# actions + route API). La clé service_role ne part JAMAIS au navigateur.

# URL du projet Supabase (même base que l'app et le back-office)
SUPABASE_URL=https://fnyuhpfzkvunscuylvqv.supabase.co

# Clé "anon" (publique — sert à la connexion des partenaires via GoTrue)
SUPABASE_ANON_KEY=eyJ...

# Clé "service_role" (SECRÈTE — ne JAMAIS l'exposer côté client).
# Supabase → Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# URL publique de la landing où atterrissent les clients d'un partenaire.
# Sert à composer le lien perso (…/?p=CODE) + le QR, et à autoriser le beacon
# de visite (CORS de /api/visits). Exposée au navigateur (non secrète).
NEXT_PUBLIC_LANDING_URL=https://lissafi.app
