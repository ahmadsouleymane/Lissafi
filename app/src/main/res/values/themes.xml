<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Lissafi" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@color/lissafi_green_dark</item>
        <item name="android:navigationBarColor">@color/lissafi_cream</item>
    </style>

    <style name="Theme.Lissafi.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lissafi_cream</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/lissafi_cream</item>
        <item name="postSplashScreenTheme">@style/Theme.Lissafi</item>
    </style>
</resources>
