# ============================================================
# LISSAFI BACK-OFFICE — variables d'environnement
# ============================================================
# Ces variables sont utilisées UNIQUEMENT côté serveur (server
# components + server actions). Rien de secret ne part au navigateur.

# URL du projet Supabase (déjà connue — voir SupabaseManager.kt)
SUPABASE_URL=https://fnyuhpfzkvunscuylvqv.supabase.co

# Clé "anon" (publique — sert à l'authentification admin GoTrue)
SUPABASE_ANON_KEY=eyJ...

# Clé "service_role" (SECRÈTE — ne JAMAIS l'exposer côté client).
# À récupérer dans Supabase → Settings → API → service_role.
# C'est elle qui donne accès à toutes les données.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ============================================================
# NOTIFICATIONS PUSH (Firebase Cloud Messaging)
# ============================================================

# Clé de compte de service Firebase Admin SDK — JSON complet sur une seule
# ligne. Firebase Console → Paramètres du projet → Comptes de service →
# Générer une nouvelle clé privée.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# Secret partagé avec Vercel Cron pour protéger /api/cron/recap-quotidien.
# Vercel l'envoie automatiquement en en-tête Authorization quand cette
# variable est définie dans les réglages du projet.
CRON_SECRET=

# ============================================================
# PORTAIL PARTENAIRE (auto-serveur)
# ============================================================

# URL publique de la landing où atterrissent les clients d'un partenaire.
# Sert à composer le lien personnel (…/?p=CODE) + le QR, et à autoriser
# le beacon de visite (CORS de /api/visits). Exposée au navigateur (non secrète).
NEXT_PUBLIC_LANDING_URL=https://lissafi-one.vercel.app

# ============================================================
# PAIEMENT EN LIGNE (iPayMoney + GeniusPay)
# ============================================================
# Clés strictement côté serveur — jamais exposées au navigateur.
# Les valeurs ci-dessous sont des placeholders ; les vraies clés
# (sandbox puis live) se mettent dans .env.local ou dans les variables Vercel.

# --- iPayMoney (Niger) ---
# Clé publique : sert au SDK JS/Android (non utilisée par l'intégration
# serveur actuelle, conservée pour référence).
IPAYMONEY_PUBLIC_KEY=pk_sandbox_...
# Clé privée : envoyée en `Authorization: Bearer` sur /api/v1/payments.
IPAYMONEY_PRIVATE_KEY=sk_sandbox_...
# "sandbox" ou "live" (header Ipay-Target-Environment).
IPAYMONEY_ENVIRONMENT=sandbox

# --- GeniusPay (reste de l'Afrique) ---
# Clé publique (header X-API-Key).
GENIUSPAY_API_KEY=pk_sandbox_...
# Clé secrète (header X-API-Secret) — ne jamais exposer côté client.
GENIUSPAY_API_SECRET=sk_sandbox_...
# Secret de signature des webhooks (whsec_...), fourni à la création du
# webhook dans le dashboard GeniusPay. Laissez vide tant que le webhook
# n'est pas créé — l'activation reste assurée par le polling de statut.
GENIUSPAY_WEBHOOK_SECRET=

# Secret de signature du token transaction_id iPayMoney (optionnel ; retombe
# sur IPAYMONEY_PRIVATE_KEY si absent).
PAYMENTS_SIGNING_SECRET=
