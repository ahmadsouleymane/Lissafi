# Domaine final de la landing — sert à rendre absolus og:image, og:url et canonical.
# Exemple : VITE_SITE_URL=https://lissafi-one.vercel.app
VITE_SITE_URL=

# Back-office qui héberge les API de paiement (/api/payments/*). Par défaut
# lissafi-admin.vercel.app — à surcharger si le back-office vit ailleurs.
# VITE_PAYMENTS_URL=https://lissafi-admin.vercel.app
VITE_PAYMENTS_URL=

# Portail partenaire (projet Vercel SÉPARÉ du back-office admin — routes
# /partenaire/* + beacon /api/visits). ⚠️ OBLIGATOIRE : sans cette variable, le
# bouton « Devenir partenaire » pointe par défaut sur le back-office admin
# (lissafi-admin.vercel.app) qui n'a PAS les routes /partenaire → 404.
# Renseigne le vrai domaine du portail déployé.
VITE_PORTAL_URL=
